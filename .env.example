APP_BASE_URL=/aerolinea

DB_HOST=127.0.0.1
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=aerolinea
DB_ROOT_PASSWORD=root

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Correo (PHPMailer). MAIL_ENCRYPTION admite starttls, ssl o none.
MAIL_HOST=smtp.ejemplo.com
MAIL_USER=tu_usuario_smtp
MAIL_PASS=tu_password_smtp
MAIL_PORT=587
MAIL_FROM=no-reply@ejemplo.com
MAIL_FROM_NAME=Volaré
MAIL_ENCRYPTION=starttls
MAIL_TIMEOUT=10

# Buzón que recibe los mensajes del formulario de contacto.
# Si se omite, se usa MAIL_FROM. Admite varias direcciones separadas por coma.
MAIL_CONTACT_TO=

# Reply-To de los correos transaccionales. Si se omite, se usa MAIL_FROM.
MAIL_REPLY_TO=

# Nombre para el saludo HELO/EHLO del servidor SMTP (opcional).
MAIL_HOSTNAME=

# DKIM es opcional. Si las tres primeras claves están vacías, no se firma.
# MAIL_DKIM_PRIVATE_KEY es la ruta al archivo .key dentro del servidor.
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_PRIVATE_KEY=
MAIL_DKIM_PASSPHRASE=
